<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- INTERNET is a manifest-only permission: no permission prompt. Required for imported web apps that reference network assets. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- No READ_EXTERNAL_STORAGE, MANAGE_EXTERNAL_STORAGE or runtime media grant. The system folder picker grants narrow persistent read access. -->
  <application android:allowBackup="false" android:label="Apps" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
